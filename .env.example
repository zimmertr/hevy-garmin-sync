# Copy to .env and fill in. docs/CONFIGURATION.md describes every variable.

# Required. From https://hevy.com/settings?developer (needs Hevy Pro).
HEVY_API_KEY=

# Required on the first start. The value this prints:
#   docker run --rm -it ghcr.io/zimmertr/hevy-garmin-sync:0.3.0 login
GARMIN_TOKEN=

# Optional. Uncomment to change the default.
#INCLUDE_HEVY_FOLDERS=Push Pull Legs,Home
#ENABLE_SCHEDULED_WORKOUTS=true
#HEVY_POLL_INTERVAL_SECONDS=60
#TZ=America/Los_Angeles
#LOG_LEVEL=INFO
#LOG_FORMAT=text

# Optional. Turns Hevy Trainer on: the auth2.0-token cookie from hevy.com.
#HEVY_SESSION=
